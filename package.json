{
  "name": "family-memories",
  "version": "0.1.0",
  "private": true,
  "description": "家族思い出スライドショー & 写真整理アプリ (P1 / デスクトップ)",
  "author": "",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:node": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('app/main/preload.cjs','dist/main/preload.cjs')\"",
    "build:renderer": "vite build",
    "build": "npm run build:node && npm run build:renderer",
    "dev:renderer": "vite",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "rebuild": "electron-rebuild -f",
    "postinstall": "node scripts/rebuild-native.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "check-disk-space": "^3.4.0",
    "exifr": "^7.1.3",
    "fluent-ffmpeg": "^2.1.3",
    "ffmpeg-static": "^5.2.0",
    "hnswlib-node": "^3.0.0",
    "onnxruntime-node": "^1.19.0",
    "sharp": "^0.33.5",
    "trash": "^9.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.1.0",
    "electron-builder": "^25.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
