{
  "//": "実 ONNX モデルを app/models/ に置き、このファイルを models.json にリネームすると NodeMLAdapter が有効になります。ファイルが揃わない間は自動的に MockMLAdapter が使われます。",
  "faceDetector": {
    "file": "face_detection_yunet.onnx",
    "inputSize": [320, 320],
    "scoreThreshold": 0.6,
    "nmsThreshold": 0.4,
    "format": "yunet15"
  },
  "faceEmbedder": {
    "file": "arcface_r50.onnx",
    "inputSize": [112, 112],
    "mean": 127.5,
    "std": 128.0
  }
}
